---
import Logo from "./Logo.astro";
import { navLinks, site } from "../data/site";
import Button from "./Button.astro";
import Container from "./Container.astro";
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-bg/70 backdrop-blur-xl">
  <Container class="flex h-16 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={`${site.name} home`}>
      <Logo class="text-[26px]" label="" />
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm text-muted">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block">
        <Button href={site.bookingHref}>Book a discovery call</Button>
      </div>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full ring-1 ring-line md:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </Container>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-line/60 md:hidden" data-menu>
    <Container class="flex flex-col gap-1 py-4">
      {
        navLinks.map((link) => (
          <a href={link.href} class="rounded-lg px-3 py-3 text-muted hover:bg-surface hover:text-fg">
            {link.label}
          </a>
        ))
      }
      <Button href={site.bookingHref} class="mt-3">Book a discovery call</Button>
    </Container>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    toggle.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  }
</script>
