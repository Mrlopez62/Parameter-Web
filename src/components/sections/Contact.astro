---
import { site } from "../../data/site";
import Container from "../Container.astro";
import DateTimePicker from "../DateTimePicker.astro";

// Netlify Forms picks this form up from the built HTML (data-netlify) and emails
// each submission to the address set under Forms > Notifications (hello@).
const formName = "discovery-call";

const timeSlots = ["09:00", "10:00", "11:00", "13:00", "14:00", "15:00", "16:00"];

const steps = [
  "Pick a day and time that suits you.",
  "We confirm by email within one business day, or suggest another time.",
  "On a 30-minute call, walk us through the work that eats your week.",
];

const field =
  "w-full rounded-xl bg-bg px-4 py-3 text-sm text-fg ring-1 ring-line placeholder:text-subtle transition-shadow focus:ring-brand-soft focus:outline-none";
const label = "mb-2 block text-sm text-muted";
---

{/* No overflow-hidden here: it would clip the date picker pop-up. */}
<section id="contact" class="relative scroll-mt-20 py-24 sm:py-32">
  <div class="glow absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

  <Container class="grid gap-14 lg:grid-cols-[1fr_1.15fr]">
    <div>
      <p class="font-mono text-xs tracking-[0.04em] text-brand-soft uppercase">Contact</p>
      <h2 class="mt-4 text-3xl font-semibold sm:text-5xl">Book a free discovery call</h2>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">
        Tell us what slows your team down. We'll tell you honestly whether automation can help, and where to start.
      </p>

      <ol class="mt-10 space-y-5">
        {
          steps.map((step, i) => (
            <li class="flex gap-4">
              <span class="font-mono text-sm text-subtle">{String(i + 1).padStart(2, "0")}</span>
              <span class="text-fg">{step}</span>
            </li>
          ))
        }
      </ol>

      <p class="mt-10 text-sm text-muted">
        Prefer email? <a href={`mailto:${site.email}`} class="text-brand-soft hover:underline">{site.email}</a>
      </p>
    </div>

    <div class="rounded-2xl bg-surface p-6 ring-1 ring-line sm:p-8">
      <form
        name={formName}
        method="POST"
        data-netlify="true"
        netlify-honeypot="company_website"
        class="grid gap-5 sm:grid-cols-2"
        data-contact-form
      >
        <input type="hidden" name="form-name" value={formName} />
        <input type="hidden" name="timezone" />
        <input type="hidden" name="requested_time" />
        <p class="hidden" aria-hidden="true">
          <label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div>
          <label for="cf-name" class={label}>Name</label>
          <input id="cf-name" name="name" required autocomplete="name" class={field} />
        </div>
        <div>
          <label for="cf-email" class={label}>Email</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" class={field} />
        </div>
        <div>
          <label for="cf-business" class={label}>Business name</label>
          <input id="cf-business" name="business" required autocomplete="organization" class={field} />
        </div>
        <div>
          <label for="cf-phone" class={label}>Phone <span class="text-subtle">(optional)</span></label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" class={field} />
        </div>
        <div class="sm:col-span-2">
          <label for="cf-message" class={label}>What would you like to automate?</label>
          <textarea
            id="cf-message"
            name="message"
            rows="4"
            required
            placeholder="e.g. We spend hours each week copying web enquiries into our CRM and chasing quotes."
            class={field}></textarea>
        </div>
        <div class="sm:col-span-2">
          <DateTimePicker id="cf-when" label="Preferred date and time" slots={timeSlots} />
        </div>

        <div class="sm:col-span-2">
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-hover disabled:opacity-60"
          >
            Request discovery call
          </button>
          <p class="mt-3 hidden text-sm text-warning" role="alert" data-form-error>
            Something went wrong sending your request. Please email us at
            <a href={`mailto:${site.email}`} class="underline">{site.email}</a>.
          </p>
        </div>
      </form>

      <div class="hidden" data-form-success tabindex="-1">
        <span class="grid size-10 place-items-center rounded-full bg-success/15 text-success">
          <svg viewBox="0 0 16 16" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <h3 class="mt-5 text-2xl font-semibold">Request sent</h3>
        <p class="mt-3 text-muted">
          You asked for <span class="text-fg" data-success-when></span>. We'll confirm by email within one business day,
          or suggest another time.
        </p>

        <p class="mt-8 font-mono text-xs tracking-[0.04em] text-subtle uppercase">Add it to your calendar</p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          <a data-cal="google" target="_blank" rel="noopener" class="cal-btn">Google Calendar</a>
          <a data-cal="outlook" target="_blank" rel="noopener" class="cal-btn">Outlook.com</a>
          <a data-cal="office" target="_blank" rel="noopener" class="cal-btn">Outlook (Microsoft 365)</a>
          <a data-cal="ics" download="parameter-discovery-call.ics" class="cal-btn">Apple Calendar / other (.ics)</a>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  @reference "../../styles/global.css";

  .cal-btn {
    @apply flex cursor-pointer items-center justify-center rounded-xl bg-surface-2 px-4 py-3 text-sm text-fg ring-1 ring-line transition-colors hover:bg-line;
  }
</style>

<script>
  import { googleCalendarUrl, icsFile, outlookCalendarUrl, type CalendarEvent } from "../../lib/calendar";

  const CALL_MINUTES = 30;
  const EMAIL = "hello@parameter.digital";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const success = document.querySelector<HTMLElement>("[data-form-success]");
  const errorEl = document.querySelector<HTMLElement>("[data-form-error]");

  if (form && success && errorEl) {
    const dateInput = form.querySelector<HTMLInputElement>('input[name="date"]')!;
    const timeInput = form.querySelector<HTMLInputElement>('input[name="time"]')!;
    const picker = form.querySelector<HTMLElement>("[data-dtp]")!;

    form.querySelector<HTMLInputElement>('input[name="timezone"]')!.value =
      Intl.DateTimeFormat().resolvedOptions().timeZone;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");
      if (!form.reportValidity()) return;
      picker.dispatchEvent(new CustomEvent("dtp:validate"));
      if (picker.dataset.valid !== "true") return;

      // "YYYY-MM-DDTHH:MM" without a zone parses as the visitor's local time.
      const start = new Date(`${dateInput.value}T${timeInput.value}`);
      const end = new Date(start.getTime() + CALL_MINUTES * 60_000);
      // dateStyle/timeStyle can't be combined with timeZoneName, so spell out the parts.
      const when = new Intl.DateTimeFormat(undefined, {
        weekday: "long",
        month: "long",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
        timeZoneName: "short",
      }).format(start);
      form.querySelector<HTMLInputElement>('input[name="requested_time"]')!.value = `${when} (${start.toISOString()})`;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      button.textContent = "Sending…";

      try {
        if (!import.meta.env.DEV) {
          const res = await fetch("/", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
          });
          if (!res.ok) throw new Error(`Form submission failed: ${res.status}`);
        }
      } catch (err) {
        console.error(err);
        errorEl.classList.remove("hidden");
        button.disabled = false;
        button.textContent = "Request discovery call";
        return;
      }

      showSuccess({ start, end, when });
    });

    function showSuccess({ start, end, when }: { start: Date; end: Date; when: string }) {
      const event: CalendarEvent = {
        title: "Discovery call with Parameter (requested)",
        description:
          `Requested discovery call with Parameter. We'll confirm this time by email within one business day, ` +
          `or suggest another. Questions? ${EMAIL}`,
        location: "Video call (link sent on confirmation)",
        start,
        end,
        organizerEmail: EMAIL,
      };

      success!.querySelector("[data-success-when]")!.textContent = when;
      success!.querySelector<HTMLAnchorElement>('[data-cal="google"]')!.href = googleCalendarUrl(event);
      success!.querySelector<HTMLAnchorElement>('[data-cal="outlook"]')!.href = outlookCalendarUrl(event);
      success!.querySelector<HTMLAnchorElement>('[data-cal="office"]')!.href = outlookCalendarUrl(event, "outlook.office.com");

      const ics = icsFile(event, `${start.getTime()}-${crypto.randomUUID()}@parameter.digital`);
      success!.querySelector<HTMLAnchorElement>('[data-cal="ics"]')!.href = URL.createObjectURL(
        new Blob([ics], { type: "text/calendar;charset=utf-8" }),
      );

      form!.classList.add("hidden");
      success!.classList.remove("hidden");
      success!.focus();
    }
  }
</script>
