---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
}

const { href, variant = "primary", class: className } = Astro.props;

const variants = {
  primary: "bg-brand text-white hover:bg-brand-hover shadow-[0_0_0_1px_rgb(255_255_255/0.08)_inset,0_8px_24px_-8px_rgb(45_91_255/0.55)]",
  secondary: "bg-surface-2 text-fg ring-1 ring-line ring-inset hover:bg-line",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-colors",
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
