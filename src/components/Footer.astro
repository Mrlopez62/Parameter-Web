---
import Logo from "./Logo.astro";
import { navLinks, site } from "../data/site";
import Container from "./Container.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <Container class="grid gap-10 py-14 md:grid-cols-[1.5fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo class="text-[24px]" label={site.name} />
      <p class="mt-4 text-sm leading-relaxed text-muted">
        Practical automation for small businesses. Less repetitive work, more time for the work that needs people.
      </p>
    </div>

    <div>
      <h2 class="font-mono text-xs tracking-[0.04em] text-subtle uppercase">Explore</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-muted hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-mono text-xs tracking-[0.04em] text-subtle uppercase">Contact</h2>
      <a href={`mailto:${site.email}`} class="mt-4 block text-sm text-muted hover:text-fg">{site.email}</a>
    </div>
  </Container>

  <Container class="flex flex-col gap-2 border-t border-line py-6 text-xs text-subtle sm:flex-row sm:justify-between">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <a href="/privacy/" class="hover:text-fg">Privacy Policy</a>
  </Container>
</footer>
